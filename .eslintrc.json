{
  "root": true,
  "ignorePatterns": [
    "dist",
    "build",
    "node_modules",
    ".nx",
    "coverage",
    "**/prisma/**/runtime/**",
    "**/prisma/**/index-browser.d.ts",
    "**/prisma/**/library.d.ts"
  ],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "ecmaVersion": 2020,
        "sourceType": "module"
      },
      "plugins": ["@typescript-eslint"],
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "parserOptions": {
        "ecmaVersion": 2020,
        "sourceType": "module"
      },
      "rules": {}
    }
  ]
}
