{
  "name": "@virtualcafe/meta-viewer-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "nx build meta-viewer-service",
    "copy:prisma": "node scripts/prisma/copy-prisma-to-dist.js apps/meta-viewer-service",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "daemon": "pnpm build && pm2 start ../../dist/apps/meta-viewer-service/main.js -i 3 --name meta-viewer-service",
    "daemon:re": "pnpm build && pm2 stop meta-viewer-service && pm2 start ../../dist/apps/meta-viewer-service/main.js -i 3 --name meta-viewer-service",
    "daemon:stop": "pm2 stop meta-viewer-service",
    "daemon:log": "pm2 logs meta-viewer-service --lines 1000",
    "start": "nx serve meta-viewer-service",
    "start:dev": "nx serve meta-viewer-service --configuration=development",
    "start:debug": "nx serve meta-viewer-service --configuration=development --inspect",
    "start:prod": "nx serve meta-viewer-service --configuration=production",
    "lint": "nx lint meta-viewer-service",
    "test": "nx test meta-viewer-service",
    "test:watch": "nx test meta-viewer-service --watch",
    "test:cov": "nx test meta-viewer-service --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:unit": "nx test meta-viewer-service",
    "start:test-app": "nx serve meta-viewer-service",
    "start:dev:infra": "tsx ./scripts/dev/start-meta-viewer-dev.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/microservices": "^11.1.8",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-socket.io": "^11.1.8",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/websockets": "^11.1.8",
    "@socket.io/redis-adapter": "^8.2.0",
    "@types/socket.io": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dayjs": "^1.11.18",
    "express": "^4.21.2",
    "kafkajs": "^2.2.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pm2": "^6.0.14",
    "redis": "^4.6.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
