{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["node"],
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "test/**/*.ts",
    "src/test-utils/**/*.ts",
    "src/util/__mocks__/**/*",
    "src/**/*.mock.ts",
    "scripts/**/*.ts"
  ]
}

