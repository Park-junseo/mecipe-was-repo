{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../dist/out-tsc",
        "module": "commonjs",
        "types": [
            "jest",
            "node"
        ]
    },
    "include": [
        "jest.config.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "test/**/*.ts",
        "src/**/*.service.mock.ts",
        "src/util/__mocks__/**/*"
    ],
    "exclude": [
        "prisma/**"
    ]
}