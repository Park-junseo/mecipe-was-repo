    "dayjs": "^1.11.18",
    "express": "^4.21.2",
    "graphql": "^16.11.0",
    "graphql-parse-resolve-info": "^4.14.1",
    "image-size": "^2.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.15.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.4",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
