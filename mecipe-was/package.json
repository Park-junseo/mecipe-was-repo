{
  "name": "@virtualcafe/mecipe-was",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "nx build mecipe-was",
    "copy:prisma": "node scripts/prisma/copy-prisma-to-dist.js mecipe-was",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "daemon": "pnpm build && pm2 start dist/main.js -i max --name web-server",
    "daemon:re": "pnpm build && pm2 stop web-server && pm2 start dist/main.js -i max --name web-server",
    "daemon:stop": "pm2 stop web-server",
    "daemon:log": "pm2 logs web-server --lines 1000",
    "start": "nx serve mecipe-was",
    "start:dev": "nx serve mecipe-was --configuration=development",
    "start:debug": "nx serve mecipe-was --configuration=development --inspect",
    "start:prod": "nx serve mecipe-was --configuration=production",
    "lint": "nx lint mecipe-was",
    "test": "nx test mecipe-was",
    "test:watch": "nx test mecipe-was --watch",
    "test:cov": "nx test mecipe-was --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:unit": "nx test mecipe-was",
    "prisma:clean": "rimraf prisma/basic",
    "prisma": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate-types": "tsx scripts/prisma/generate-prisma-types.ts",
    "start:test-db": "tsx ./scripts/prisma/test-db-setup.dev.ts",
    "start:test-app": "nx serve mecipe-was",
    "start:test": "tsx./scripts/prisma/test-db-setup.dev.ts --start-app",
    "db:seed": "tsx ./scripts/prisma/seed.dev/index.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.2.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/graphql": "^13.2.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/platform-socket.io": "^11.1.8",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/websockets": "^11.1.8",
    "@prisma/client": "^6.19.0",
    "@types/socket.io": "^3.0.2",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
