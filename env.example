# ========================================
# Docker 설정
# ========================================
DOCKER_USERNAME=your_dockerhub_username  # Docker Hub 사용자명 (선택, 로컬 빌드 시 'local')

# ========================================
# 애플리케이션 설정
# ========================================
NODE_ENV=production
PORT=4000          # NestJS HTTP 포트 (Nginx가 이 포트로 프록시)
SOCKET_PORT=4100   # WebSocket 포트 (Nginx가 이 포트로 프록시)

# ========================================
# 도메인 설정 (Nginx 자동 적용)
# ========================================
DOMAIN_NAME=your-domain.com
SSL_EMAIL=your-email@example.com

# ========================================
# 데이터베이스 설정 (PostgreSQL - 외부 서버)
# ========================================
# DATABASE_URL에 외부 PostgreSQL 서버 URL을 입력하세요
# 형식: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://mecipe_user:your_password_here@your-db-host:5432/mecipe_db?schema=public"

# PostgreSQL 연결 정보 (헬스체크 및 Helm 배포용)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=mydb

# 로컬 PostgreSQL을 Docker로 사용하려면 아래 주석을 해제하고
# docker-compose.yml에 db 서비스를 추가하세요
# POSTGRES_DB=mecipe_db
# POSTGRES_USER=mecipe_user
# POSTGRES_PASSWORD=your_password_here

# ========================================
# JWT 및 인증 설정
# ========================================
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production
SECRET_LOGIN_CRYPTO=your_login_crypto_secret_here

# ========================================
# API Keys
# ========================================
API_KEY=your_api_key_here
BUILD_API_KEY=your_build_api_key_here

# ========================================
# Secret Keys (도메인별 암호화)
# ========================================
COUPON_SECRET=your_coupon_secret_here
PRODUCT_SECRET=your_product_secret_here

# ========================================
# Elasticsearch 설정 (헬스체크 및 Helm 배포용)
# ========================================
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elasticsearch_password_here

# ========================================
# 인스턴스 내부 IP (선택사항)
# ========================================
# 인스턴스 간 통신을 위한 내부 IP
# 설정하지 않으면 자동으로 감지
INSTANCE_B_INTERNAL_IP=192.168.1.100

# ========================================
# Kibana 설정 (선택사항)
# ========================================
KIBANA_PASSWORD=your_kibana_password_here

